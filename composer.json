{
    "name": "shadow-software/dabdash-php-sdk",
    "description": "PHP SDK for the DabDash Tenant API",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.3",
        "guzzlehttp/psr7": "^1.7 || ^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "ShadowSoftware\\Sdk\\Generated\\": "generated/lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ShadowSoftware\\Sdk\\Generated\\Test\\": "generated/test/"
        }
    },
    "scripts": {
        "test": "if [ -d generated/test ]; then phpunit --bootstrap vendor/autoload.php generated/test; else echo \"no generated client yet\"; fi"
    }
}
