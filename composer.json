{
    "name": "shadow-software/dabdash-php-sdk",
    "description": "PHP SDK for the DabDash Tenant API",
    "homepage": "https://dabdash.com/docs/api",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.3",
        "guzzlehttp/psr7": "^1.7 || ^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "ShadowSoftware\\DabDash\\": "generated/lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ShadowSoftware\\DabDash\\Test\\": "generated/test/",
            "ShadowSoftware\\DabDash\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml.dist"
    },
    "version": "6.3.0"
}
